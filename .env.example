# Скопируй в .env.local и заполни (см. lib/llm.ts).
# .env.local не коммитится; после правки перезапусти dev-сервер —
# EXPO_PUBLIC_* зашиваются в бандл при сборке.

# Эндпоинт прокси (формат Anthropic Messages API). Пусто = работать на
# курируемых вопросах без ИИ.
EXPO_PUBLIC_AI_PROXY_URL=

# Клиентский ключ доступа к прокси (уходит в заголовок Authorization: Bearer)
EXPO_PUBLIC_AI_PROXY_KEY=

# Модель; по умолчанию claude-opus-4-8
EXPO_PUBLIC_AI_MODEL=
