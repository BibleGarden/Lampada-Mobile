# Copy to .env.local and fill in the client key (see lib/llm.ts).
# .env.local is not committed. Restart the development server after changes:
# EXPO_PUBLIC_* variables are embedded into the bundle at build time.

# Base origin of bible-api, without an endpoint path. Without a configured server,
# the app uses its bundled fallback questions.
EXPO_PUBLIC_API_URL=https://api.bible.garden

# Limited bible-api client key, not a model-provider secret. Embedded into the
# app and sent in the X-API-Key header.
EXPO_PUBLIC_AI_PROXY_KEY=
