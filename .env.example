# Скопируй в .env.local и заполни (см. lib/llm.ts).
# .env.local не коммитится; после правки перезапусти dev-сервер —
# EXPO_PUBLIC_* зашиваются в бандл при сборке.

# Gemini-прокси в существующем bible-api. Пусто = работать на курируемых
# вопросах без ИИ.
EXPO_PUBLIC_AI_PROXY_URL=https://api.bible.garden/api/lampada/v1/complete

# Клиентский ключ bible-api (НЕ ключ Google AI Studio). Он встраивается в
# приложение и не считается секретом; уходит в заголовок X-API-Key.
EXPO_PUBLIC_AI_PROXY_KEY=
