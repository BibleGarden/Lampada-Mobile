{
  "expo": {
    "name": "Lampada",
    "slug": "pray",
    "version": "1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "locales": {
      "ru": "./languages/ru.json",
      "uk": "./languages/uk.json"
    },
    "ios": {
      "bundleIdentifier": "twinkler",
      "deploymentTarget": "16.4",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ],
        "NSMicrophoneUsageDescription": "Микрофон нужен для голосовых молитвенных ответов. Запись хранится на устройстве и может быть отправлена провайдеру ИИ для расшифровки только по вашему запросу.",
        "NSFaceIDUsageDescription": "Face ID используется для разблокировки приложения.",
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.nf404.twinkler",
      "adaptiveIcon": {
        "backgroundColor": "#0e0a07",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#e6a23c",
          "defaultChannel": "prayer_reminders",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "expo-status-bar",
      "expo-asset",
      "expo-localization",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "twinkler.ExpoWidgetsTarget",
          "groupIdentifier": "group.twinkler",
          "enablePushNotifications": false,
          "frequentUpdates": false,
          "widgets": []
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Face ID используется для разблокировки приложения."
        }
      ]
    ],
    "scheme": "lampada",
    "backgroundColor": "#0e0a07",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e62a017e-2102-46fd-bee1-bb27168ed549"
      }
    },
    "owner": "nf404"
  }
}
