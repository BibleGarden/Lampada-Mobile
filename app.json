{
  "expo": {
    "name": "Лампада",
    "slug": "pray",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.marianovikov.lampada",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Микрофон нужен, чтобы записывать голосовые молитвенные ответы. Записи хранятся только на этом устройстве.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0e0a07",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      "expo-audio",
      "expo-status-bar"
    ],
    "scheme": "lampada",
    "backgroundColor": "#0e0a07"
  }
}