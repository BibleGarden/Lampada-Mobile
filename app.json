{
  "expo": {
    "name": "Lampada",
    "slug": "pray",
    "version": "1.3.25",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "locales": {
      "ru": "./languages/ru.json",
      "uk": "./languages/uk.json",
      "en": "./languages/en.json"
    },
    "ios": {
      "bundleIdentifier": "twinkler",
      "deploymentTarget": "16.4",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ],
        "NSMicrophoneUsageDescription": "The microphone is used to record spoken prayer responses. Recordings stay on your device and are sent for AI transcription only when you request it.",
        "NSFaceIDUsageDescription": "Face ID is used to unlock the app.",
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.lampada",
      "adaptiveIcon": {
        "backgroundColor": "#0e0a07",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withAndroidBuild",
      "./plugins/withAndroidBackupRules",
      "expo-router",
      "expo-font",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#e6a23c",
          "defaultChannel": "prayer_reminders",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "expo-status-bar",
      "expo-asset",
      "expo-localization",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "twinkler.ExpoWidgetsTarget",
          "groupIdentifier": "group.twinkler",
          "enablePushNotifications": false,
          "frequentUpdates": false,
          "widgets": []
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Face ID is used to unlock the app."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0e0a07",
          "image": "./assets/splash.png",
          "imageWidth": 200
        }
      ]
    ],
    "scheme": "lampada",
    "backgroundColor": "#0e0a07",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e62a017e-2102-46fd-bee1-bb27168ed549"
      }
    },
    "owner": "nf404"
  }
}
